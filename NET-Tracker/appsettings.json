{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Server=db53359.public.databaseasp.net; Database=db53359; User Id=db53359; Password=Mo@123456; Encrypt=True; TrustServerCertificate=True; MultipleActiveResultSets=True; "
  },

  "NetTracker": {
    "Enabled": true,
    "LogRequestBody": true,
    "LogResponseBody": true,
    "LogHeaders": true,
    "MaxBodySize": 1048576,
    "ExcludePaths": [
      "/health",
      "/metrics",
      "/swagger",
      "/api/swagger",
      "/.well-known",
      "/favicon.ico"
    ],
    "ExcludeMethods": [],
    "IncludeQueryString": true,
    "LogSensitiveData": false,
    "SensitivePatterns": [
      "password",
      "apikey",
      "api_key",
      "token",
      "authorization",
      "ssn",
      "creditcard",
      "credit_card",
      "secret",
      "private_key",
      "privatekey"
    ],
    "Storage": {
      "Type": "Database",
      "DatabaseProvider": "SqlServer",
      "ConnectionString": "",
      "UseSeparateDatabase": false
    },
    "Retention": {
      "DaysToKeep": 30,
      "CleanupSchedule": "0 2 * * *",
      "AutoCleanup": true,
      "ArchiveOldLogs": false,
      "ArchiveDirectory": "Logs/Http/Archive"
    },
    "Performance": {
      "UseAsyncLogging": true,
      "MaxQueueSize": 10000,
      "EnableCaching": true,
      "CacheDurationMinutes": 60,
      "CompressBodyContent": true,
      "UseBatchInserts": true,
      "BatchInsertSize": 100
    }
  }
}
