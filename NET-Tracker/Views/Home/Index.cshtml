@{
    Layout = null;
    ViewData["Title"] = "NET-Tracker | HTTP Logging & Monitoring";
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Modern Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['Fira Code', 'monospace'],
                    },
                    colors: {
                        dark: {
                            bg: '#0f172a',
                            card: '#1e293b',
                            border: '#334155'
                        },
                        primary: {
                            500: '#3b82f6',
                            600: '#2563eb'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #0f172a;
            color: #f8fafc;
            overflow-x: hidden;
        }
        
        .glass-card {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }

        .gradient-text {
            background: linear-gradient(135deg, #38bdf8, #818cf8, #c084fc);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .glow-effect {
            position: absolute;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(56, 189, 248, 0.15) 0%, rgba(0,0,0,0) 70%);
            top: -200px;
            left: 50%;
            transform: translateX(-50%);
            z-index: -1;
            pointer-events: none;
        }

        /* Syntax Highlighting Base */
        .code-block {
            background-color: #0d1117;
            border-radius: 0.75rem;
            padding: 1.5rem;
            overflow-x: auto;
            border: 1px solid #30363d;
            font-size: 0.9rem;
            line-height: 1.5;
        }
        .token-keyword { color: #ff7b72; }
        .token-method { color: #d2a8ff; }
        .token-string { color: #a5d6ff; }
        .token-class { color: #79c0ff; }
        .token-comment { color: #8b949e; font-style: italic; }
    </style>
</head>
<body class="antialiased selection:bg-primary-500 selection:text-white relative">
    
    <div class="glow-effect"></div>

    <!-- Navigation -->
    <nav class="border-b border-white/10 bg-dark-bg/80 backdrop-blur-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center shadow-lg">
                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                    </div>
                    <span class="font-bold text-xl tracking-tight">NET-Tracker</span>
                </div>
                <div class="flex items-center gap-4">
                    <a href="https://github.com/" target="_blank" class="text-slate-400 hover:text-white transition-colors">
                        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path></svg>
                    </a>
                    <a asp-controller="Dashboard" asp-action="Index" class="bg-primary-600 hover:bg-primary-500 text-white px-5 py-2 rounded-lg font-medium transition-all shadow-lg shadow-blue-500/25">
                        Open Dashboard
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-16 text-center">
        <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight mb-6">
            The Ultimate <br/>
            <span class="gradient-text">HTTP Monitoring</span> <br/>
            for ASP.NET Core
        </h1>
        <p class="mt-4 max-w-2xl text-lg md:text-xl text-slate-400 mx-auto mb-10">
            Automatically intercept, log, mask, and analyze every HTTP request and response in your API. Built with OpenTelemetry, Resilience, and Zero-Overhead caching.
        </p>
        
        <div class="flex justify-center gap-4">
            <a href="#integration" class="bg-white text-dark-bg px-8 py-3 rounded-xl font-bold text-lg hover:bg-slate-200 transition-colors shadow-[0_0_20px_rgba(255,255,255,0.3)]">
                Integration Guide
            </a>
            <a asp-controller="Dashboard" asp-action="Index" class="glass-card px-8 py-3 rounded-xl font-bold text-lg text-white hover:bg-white/10 transition-colors flex items-center gap-2">
                Live Demo 
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </a>
        </div>
    </main>

    <!-- Features Grid -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Feature 1 -->
            <div class="glass-card p-8 rounded-2xl">
                <div class="w-12 h-12 bg-blue-500/10 rounded-xl flex items-center justify-center mb-6">
                    <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                </div>
                <h3 class="text-xl font-bold mb-3">Zero Overhead</h3>
                <p class="text-slate-400 leading-relaxed">Uses Channels and BackgroundServices to asynchronously queue logs. Your API responses are never delayed by database writes.</p>
            </div>
            <!-- Feature 2 -->
            <div class="glass-card p-8 rounded-2xl">
                <div class="w-12 h-12 bg-purple-500/10 rounded-xl flex items-center justify-center mb-6">
                    <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                </div>
                <h3 class="text-xl font-bold mb-3">Data Privacy</h3>
                <p class="text-slate-400 leading-relaxed">Automatic masking of sensitive headers and JSON payloads (Passwords, Tokens, Credit Cards) before data ever hits the database.</p>
            </div>
            <!-- Feature 3 -->
            <div class="glass-card p-8 rounded-2xl">
                <div class="w-12 h-12 bg-green-500/10 rounded-xl flex items-center justify-center mb-6">
                    <svg class="w-6 h-6 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path></svg>
                </div>
                <h3 class="text-xl font-bold mb-3">1GB DB Friendly</h3>
                <p class="text-slate-400 leading-relaxed">Built-in auto-cleanup policies. Limit by days or enforce strict max-row limits to ensure your database never runs out of space.</p>
            </div>
        </div>
    </section>

    <!-- Integration Guide Section -->
    <section id="integration" class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
        <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">How to Integrate</h2>
            <p class="text-slate-400 text-lg">Adding NET-Tracker to your own systems is just 2 lines of code.</p>
        </div>

        <div class="space-y-8">
            <!-- Step 1 -->
            <div>
                <h4 class="text-xl font-semibold mb-3 flex items-center gap-3">
                    <span class="w-8 h-8 rounded-full bg-blue-500/20 text-blue-400 flex items-center justify-center text-sm">1</span> 
                    Register the Services
                </h4>
                <p class="text-slate-400 mb-3 text-sm">In your <code class="bg-white/10 px-2 py-1 rounded">Program.cs</code>, register the DbContext and the HTTP Logging decorators.</p>
                <div class="code-block font-mono text-sm shadow-xl">
<pre><span class="token-comment">// 1. Add your connection string</span>
<span class="token-keyword">var</span> connectionString <span class="token-keyword">=</span> builder<span class="token-keyword">.</span>Configuration<span class="token-keyword">.</span><span class="token-method">GetConnectionString</span><span class="token-keyword">(</span><span class="token-string">"DefaultConnection"</span><span class="token-keyword">);</span>

<span class="token-comment">// 2. Add NET-Tracker Services</span>
builder<span class="token-keyword">.</span>Services<span class="token-keyword">.</span><span class="token-method">AddHttpRequestResponseLogging</span><span class="token-keyword">(</span>options <span class="token-keyword">=></span>
<span class="token-keyword">{</span>
    options<span class="token-keyword">.</span>LogBodyOnlyOnErrors <span class="token-keyword">=</span> <span class="token-keyword">true</span><span class="token-keyword">;</span>
    options<span class="token-keyword">.</span>Retention<span class="token-keyword">.</span>MaxRowsToKeep <span class="token-keyword">=</span> <span class="token-keyword">10000</span><span class="token-keyword">;</span>
<span class="token-keyword">});</span></pre>
                </div>
            </div>

            <!-- Step 2 -->
            <div>
                <h4 class="text-xl font-semibold mb-3 flex items-center gap-3">
                    <span class="w-8 h-8 rounded-full bg-blue-500/20 text-blue-400 flex items-center justify-center text-sm">2</span> 
                    Add the Middleware
                </h4>
                <p class="text-slate-400 mb-3 text-sm">Enable the middleware in your request pipeline. Make sure to place it <strong>before</strong> your controllers.</p>
                <div class="code-block font-mono text-sm shadow-xl">
<pre><span class="token-keyword">var</span> app <span class="token-keyword">=</span> builder<span class="token-keyword">.</span><span class="token-method">Build</span><span class="token-keyword">();</span>

<span class="token-comment">// 3. Use the Logging Middleware</span>
app<span class="token-keyword">.</span><span class="token-method">UseHttpRequestResponseLogging</span><span class="token-keyword">();</span>

app<span class="token-keyword">.</span><span class="token-method">MapControllers</span><span class="token-keyword">();</span>
app<span class="token-keyword">.</span><span class="token-method">Run</span><span class="token-keyword">();</span></pre>
                </div>
            </div>
            
            <!-- Step 3 -->
            <div>
                <h4 class="text-xl font-semibold mb-3 flex items-center gap-3">
                    <span class="w-8 h-8 rounded-full bg-blue-500/20 text-blue-400 flex items-center justify-center text-sm">3</span> 
                    Configuration (appsettings.json)
                </h4>
                <p class="text-slate-400 mb-3 text-sm">Customize behavior directly from your configuration file.</p>
                <div class="code-block font-mono text-sm shadow-xl">
<pre><span class="token-keyword">"HttpRequestResponseLogging"</span><span class="token-keyword">: {</span>
  <span class="token-string">"Enabled"</span><span class="token-keyword">:</span> <span class="token-keyword">true</span><span class="token-keyword">,</span>
  <span class="token-string">"LogBodyOnlyOnErrors"</span><span class="token-keyword">:</span> <span class="token-keyword">true</span><span class="token-keyword">,</span>
  <span class="token-string">"ExcludePaths"</span><span class="token-keyword">: [</span>
    <span class="token-string">"/health"</span><span class="token-keyword">,</span> <span class="token-string">"/swagger"</span>
  <span class="token-keyword">],</span>
  <span class="token-string">"Retention"</span><span class="token-keyword">: {</span>
    <span class="token-string">"DaysToKeep"</span><span class="token-keyword">:</span> <span class="token-keyword">2</span><span class="token-keyword">,</span>
    <span class="token-string">"MaxRowsToKeep"</span><span class="token-keyword">:</span> <span class="token-keyword">10000</span>
  <span class="token-keyword">}</span>
<span class="token-keyword">}</span></pre>
                </div>
            </div>

        </div>
    </section>

    <footer class="border-t border-white/10 mt-20 py-8 text-center text-slate-500 text-sm">
        <p>Built with ❤️ for the .NET Open Source Community. Fully compatible with .NET 8.</p>
    </footer>

</body>
</html>
